generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Sincronizado con Supabase Auth (auth.users.id)
model User {
  id        String        @id @db.Uuid
  email     String        @unique
  createdAt DateTime      @default(now())
  decks     Deck[]
  settings  UserSettings?

  @@map("users")
}

// Preferencias del usuario (intervalos Leitner configurables, etc.)
model UserSettings {
  userId     String   @id @db.Uuid
  intervalos Int[]    @default([1, 3, 7, 15, 30])
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Deck {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  nombre      String
  descripcion String?
  color       String?  @default("#1D4ED8")
  icon        String?
  tags        String[] @default([])
  metaDiaria  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([userId])
  @@map("decks")
}

model Card {
  id              String   @id @default(uuid()) @db.Uuid
  deckId          String   @db.Uuid
  frontText       String
  backText        String
  hint            String?
  notas           String?
  tags            String[] @default([])
  cajaActual      Int      @default(1)
  proximaRevision DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deck    Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  reviews Review[]

  @@index([deckId])
  @@index([proximaRevision])
  @@map("cards")
}

model Review {
  id            String   @id @default(uuid()) @db.Uuid
  cardId        String   @db.Uuid
  resultado     Boolean
  fechaRevision DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("reviews")
}
