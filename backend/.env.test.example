# Copiar a .env.test para ejecutar los tests de integración.
# Requiere PostgreSQL 16 en Docker. Ejemplo:
# docker run --name leitner-test-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=leitner_test -p 5434:5432 -d postgres:16
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/leitner_test?schema=public
