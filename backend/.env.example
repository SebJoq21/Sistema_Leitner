# Copiar a .env y completar con datos de Supabase
PORT=3001

# Supabase (Dashboard > Project Settings > API)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=changeme
SUPABASE_SERVICE_ROLE_KEY=

# Runtime (pooler, puerto 6543 + ?pgbouncer=true) — usado por PrismaPg adapter
# Ej Supabase: postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:6543/postgres?pgbouncer=true&schema=public

# Migraciones (directa, puerto 5432) — usada en prisma.config.ts
# Ej Supabase: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/postgres?schema=public
