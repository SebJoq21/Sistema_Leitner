# Copiar a .env y completar con datos de Supabase (crear proyecto desde cero)
PORT=3001

# Supabase (Dashboard > Project Settings > API)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=changeme
SUPABASE_SERVICE_ROLE_KEY=changeme

# Postgres — Supabase (Dashboard > Project Settings > Database > Connection string)
# Formato: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/postgres?schema=public
